{
    "name": "alberv/smart_parking",
    "description": "Web application for managing parking structure",
    "type": "project",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Albert van Kiel",
            "email": "albertvankiel@gmail.com"
        }
    ],
    "require": {
        "firebase/php-jwt": "^7.0"
    },
    "scripts": {
        "post-root-package-install": [
            "php bin/setup.php"
        ],
        "post-install-cmd": [
            "php bin/setup.php"
        ],
        "setup": [
            "php bin/setup.php"
        ]
    }
}
